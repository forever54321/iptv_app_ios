<?xml version="1.0" encoding="utf-8" ?>
<component name="SectionGroupsScreen" extends="Group">
    <interface>
        <field id="action" type="assocarray" alwaysNotify="true" />
        <field id="section" type="string" />
        <field id="title" type="string" value="Groups" />
        <field id="restoreFocus" type="boolean" alwaysNotify="true" />
    </interface>
    <script type="text/brightscript" uri="SectionGroupsScreen.brs" />
    <script type="text/brightscript" uri="pkg:/components/services/StringUtils.brs" />
    <script type="text/brightscript" uri="pkg:/components/localization/AppStrings.brs" />

    <children>
        <Rectangle width="1920" height="1080" color="#0F0A23" />
        <Label id="titleLabel" translation="[90, 50]" font="font:LargeBoldSystemFont" color="#9B59B6" />

        <Rectangle translation="[90, 115]" width="1740" height="2" color="#9B59B633" />

        <Button id="searchButton" text="🔍 Search channels..." translation="[90, 135]" minWidth="500" />

        <LabelList id="groupList" translation="[90, 220]"
                   itemSize="[1740, 70]" numRows="10"
                   color="#BBBBBB" focusedColor="#FFFFFF"
                   focusBitmapBlendColor="#9B59B640"
                   drawFocusFeedback="true"
                   vertFocusAnimationStyle="floatingFocus" />
    </children>
</component>
