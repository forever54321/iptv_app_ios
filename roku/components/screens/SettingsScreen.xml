<?xml version="1.0" encoding="utf-8" ?>
<component name="SettingsScreen" extends="Group">
    <interface>
        <field id="action" type="assocarray" alwaysNotify="true" />
    </interface>
    <script type="text/brightscript" uri="SettingsScreen.brs" />
    <script type="text/brightscript" uri="pkg:/components/services/RegistryService.brs" />
    <script type="text/brightscript" uri="pkg:/components/localization/AppStrings.brs" />

    <children>
        <Rectangle width="1920" height="1080" color="#0F0A23" />
        <Label text="Settings" translation="[90, 50]" font="font:LargeBoldSystemFont" color="#9B59B6" />
        <Rectangle translation="[90, 115]" width="1740" height="2" color="#9B59B633" />

        <LabelList id="settingsList" translation="[90, 140]"
                   itemSize="[1740, 75]" numRows="10"
                   color="#BBBBBB" focusedColor="#FFFFFF"
                   focusBitmapBlendColor="#9B59B640"
                   drawFocusFeedback="true"
                   vertFocusAnimationStyle="floatingFocus" />
    </children>
</component>
